{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@tests/*": ["tests/*"],
      "@utils/*": ["utils/*"],
      "@api/*": ["api/*"],
      "@auth/*": ["tests/auth/*"],
      "@constants/*": ["constants/*"],
      "@fixtures/*": ["fixtures/*"],
      "@test-data/*": ["test-data/*"]
    },
    "types": ["node", "@playwright/test"]
  },
  "include": ["tests", "pages", "utils", "api", "tests/auth", "constants", "fixtures", "test-data", "playwright.config.ts", "**/*.ts",
    "**/*.d.ts"]
}
